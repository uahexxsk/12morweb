# Supabase Project settings -> API. Keep the service role key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Same public values are embedded into the client during the Docker build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Pastefy account API token (https://pastefy.app/apikeys). Server-side only.
PASTEFY_API_TOKEN=

# Required: random secret of 32+ characters for the outer Lua payload wrapper
OBF_XOR_KEY=

# Cookie/session secret; generate a different random value for production
SESSION_SECRET=

# Optional server resource limits
HUB12_BUILD_TIMEOUT_MS=240000
HUB12_MAX_CONCURRENT_JOBS=2
